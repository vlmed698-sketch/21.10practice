# Сторонние файлы, которые собирает scripts/collect-vendor.sh (иконки, шрифты, звуки,
# чужие плазмоиды, собранные бинарники) — в репозиторий не попадают
/vendor/

# Готовый установщик и промежуточные файлы сборки
/dist/
/build/
*.tar.xz

# Временные файлы и остатки патчей
temp/
*.orig
*.rej
*~
*.swp
*.log

# Python-кэш и окружение (на случай вспомогательных скриптов)
__pycache__/
*.pyc
.venv/

# Локальные секреты и настройки редакторов
.env
.vscode/
.idea/
.directory
