+void DockPanel::updateBlurRegion(const QRect& rect, int radius) {
+  if (rect == blurRect_ && radius == blurRadius_) {
+    return;
+  }
+  blurRect_ = rect;
+  blurRadius_ = radius;
+  if (windowHandle() == nullptr) {
+    return;
+  }
+  QPainterPath path;
+  path.addRoundedRect(QRectF(rect), radius, radius);
+  KWindowEffects::enableBlurBehind(windowHandle(), true, QRegion(path.toFillPolygon().toPolygon()));
+}
